{
  "name": "web-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-projects.mjs && node scripts/generate-og-pages.mjs && node scripts/validate-dist.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll",
    "test:dist": "node scripts/validate-dist.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:history": "node scripts/verify-history.mjs",
    "test:witch": "node scripts/test-witch.mjs",
    "test:witch-expansion": "node scripts/test-witch-expansion.mjs",
    "test:witch-motion": "node scripts/test-witch-motion.mjs",
    "test:witch-movement": "node scripts/test-witch-movement.mjs",
    "witch:export-props": "node scripts/export-witch-props.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "gh-pages": "^6.3.0",
    "jquery": "^3.7.1",
    "lucide-react": "^0.556.0",
    "matter-js": "^0.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "tailwindcss": "^4.1.17",
    "three": "^0.181.2",
    "phaser3": "npm:phaser@3.88.2",
    "phaser4": "npm:phaser@4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "typescript6": "npm:typescript@~6.0.2"
  },
  "homepage": "https://asa9874.github.io/web-hub/"
}
